# Next.js public environment variables are embedded in the browser bundle.
# Only use NEXT_PUBLIC_ prefix for non-sensitive config (API URLs, feature flags).
# NEVER store secrets here (API keys, tokens, credentials) — they are visible to users.
# Dev host is 127.0.0.1 for frontend AND API (see docs/adr/0004). Do not mix with localhost:
# browsers treat them as different sites, so the refresh cookie would not be sent.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
