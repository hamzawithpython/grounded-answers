# Database (password must match POSTGRES_PASSWORD in root .env)
DATABASE_URL=postgresql+psycopg://postgres:change-me-local-only@127.0.0.1:5432/grounded_answers

# Cache
# db=0 for app; db=1 for celery if added later
REDIS_URL=redis://127.0.0.1:6379/0

# Logging
LOG_LEVEL=info

# CORS
# Comma-separated list of allowed origins. Never use "*" (security risk).
# Default allows local dev frontend on both 127.0.0.1 and localhost.
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
