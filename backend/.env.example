# Database: the running app connects as app_user (least privilege, ADR 0004, ADR 0005).
# Never use the postgres superuser here. Replace the placeholder with the password set in
# the operator bootstrap (docs/RUNBOOK.md).
DATABASE_URL=postgresql+psycopg://app_user:change-me-local-only@127.0.0.1:5432/grounded_answers

# Migration credentials are NOT in this file. The web app loads it (ADR 0004), so the
# migration role's URL never goes here. Set MIGRATION_DATABASE_URL in the shell only
# (docs/RUNBOOK.md, "Run migrations").

# Tests only, never read by the app. Set it in the shell before pytest -m db (docs/RUNBOOK.md).
# It must point at the TEST cluster on port 5433, never at the dev cluster on 5432 (ADR 0006).
# TEST_ADMIN_DATABASE_URL=postgresql://postgres:<TEST_POSTGRES_PASSWORD>@127.0.0.1:5433/postgres

# Cache
# db=0 for app; db=1 for celery if added later
REDIS_URL=redis://127.0.0.1:6379/0

# Logging
LOG_LEVEL=info

# CORS
# Comma-separated list of allowed origins. Never use "*" (security risk).
# Dev frontend runs on 127.0.0.1 (see docs/RUNBOOK.md). Add production origins here
# as exact URLs, e.g. https://app.example.com (no trailing slash, no path).
CORS_ORIGINS=http://127.0.0.1:3000
