# PostgreSQL (used by docker-compose)
# Local development only; never commit real secrets
POSTGRES_DB=grounded_answers
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-only

# Test PostgreSQL (docker compose --profile test, port 5433). A separate cluster, so the test
# fixture's password resets never touch the dev cluster (ADR 0006). Generate the password with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(24))"
# Use only URL-safe characters (letters, digits, - and _), because it goes into a URL.
TEST_POSTGRES_USER=postgres
TEST_POSTGRES_PASSWORD=change-me-test-only
